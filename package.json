{
  "name": "luminor-pdv-sorveteria",
  "version": "0.2.0",
  "private": true,
  "description": "MVP local Node.js para sorveteria: balança Toledo Prix 3 Fit, caixa, produtos e relatórios",
  "type": "commonjs",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test tests/*.test.js",
    "test:postgres": "node tests/run-postgres.js",
    "build:demo": "node demo/build.js",
    "backup": "node src/cli/backup.js",
    "migrar:postgres": "node src/database/migration-tools/cli.js",
    "admin:redefinir": "node src/cli/admin-reset.js"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "sql.js": "1.14.2"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "pg": "8.23.1"
  }
}
